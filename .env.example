# Base URL of the LiteLLM gateway (OpenAI-compatible), including /v1.
# No default is baked into the app: this variable is required.

# Workshop gateway (online):
LLM_BASE_URL=https://r7umxvllm.denisakp.me/v1

# Local LiteLLM instead — comment the line above, uncomment one below.
# Running the app with uvicorn on the host:
# LLM_BASE_URL=http://localhost:4000/v1
# Running the app in a container, gateway on the host (macOS / Windows):
# LLM_BASE_URL=http://host.docker.internal:4000/v1

# LiteLLM virtual key handed to you for the workshop. Never commit a real one.
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Model alias exposed by the gateway
LLM_MODEL=default
